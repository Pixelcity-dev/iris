# Iris Dashboard — production environment template.
# Copy to .env and fill secrets. NEVER commit .env.

# Required: session signing secret (openssl rand -hex 32)
SESSION_SECRET=

# Keycloak OIDC (realm pcid). Create client `iris-dashboard` (confidential,
# standard flow) with redirect https://dashboard.pixelcity.dev/auth/callback.
OIDC_ISSUER=https://id.pixelcity.dev/realms/pcid
OIDC_CLIENT_ID=iris-dashboard
OIDC_CLIENT_SECRET=
OIDC_REDIRECT_URL=https://dashboard.pixelcity.dev/auth/callback

# Zoneless billing (platform API key, server-side only).
# Reachable inside docker network; falls back to graceful Free plan.
PAYMENTS_BASE=http://172.18.0.114:80
PAYMENTS_API_KEY=

# Iris plan price IDs in Zoneless (one-time monthly/annual SKUs).
PRICE_PRO_MONTHLY=
PRICE_PRO_YEARLY=
PRICE_ENT_MONTHLY=
PRICE_ENT_YEARLY=

# Listen address inside the container.
LISTEN=:8080
COOKIE_SECURE=true
